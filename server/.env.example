# Copy to server/.env for local development. Do not put production secrets here.
# The database user, password, and name below are the local Docker defaults only.

NODE_ENV=development
PORT=3001
HOST=0.0.0.0
DATABASE_URL=postgres://auralithic:auralithic@localhost:5433/auralithic

# disk (default in development) or r2. Required in production.
MEDIA_DRIVER=disk
# Required in production when MEDIA_DRIVER=disk. Development defaults to ../public/media.
MEDIA_ROOT=../public/media

# Required only when MEDIA_DRIVER=r2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Only this address can receive a login code. Compared case-insensitively.
ADMIN_EMAIL=admin@example.com
# At least 32 characters. Pepper for login-code hashes.
SESSION_SECRET=

# Browser origin of the collective station.
# Production: https://auralithic.fm
# Artist radios are a single subdomain of that host, for example https://hxlloghxst.auralithic.fm
# Local artist radios are http://<slug>.localhost:5173
APP_ORIGIN=http://127.0.0.1:5173
ADMIN_ORIGIN=http://127.0.0.1:5173

# Admin is a password, not an email form.
# On the machine with the database, run: npm run db:seed-admin
# Type the password at that prompt. Do not put it in this file.
# MAIL_MODE=off in production. smtp is only for the unused email-code route.
# log prints a code on the server and is rejected in production.
MAIL_MODE=log
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Trust one reverse-proxy hop only when this is true.
TRUST_PROXY=false
